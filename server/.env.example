# ===== Server =====
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ===== MongoDB =====
MONGO_URI=mongodb://127.0.0.1:27017/jobbridge

# ===== Auth =====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=jb_token

# ===== Email =====
# Tried in this order: Gmail API (see GOOGLE_* + GMAIL_SENDER_EMAIL below),
# then SendGrid, then SMTP. The first one that's configured wins. Gmail API
# and SendGrid both send over HTTPS, so they work on hosts that block
# outbound SMTP ports (e.g. Render's free tier) — SMTP is fine locally but
# may not work in production. See README for setup of each.
SENDGRID_API_KEY=
SENDGRID_FROM="Hirevion <no-reply@hirevion.local>"

# SMTP (Nodemailer) — used only when neither Gmail API nor SendGrid is
# configured. Fine for local development; some hosts block outbound SMTP
# in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hirevion <no-reply@hirevion.local>"

# ===== Uploads =====
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
MAX_RESUME_SIZE=5242880
MAX_PHOTO_SIZE=2097152

# ===== AI Summary (optional) =====
# If left blank, a deterministic rule-based summary generator is used instead.
AI_PROVIDER=
AI_API_KEY=

# ===== Rate limiting =====
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ===== Google Calendar / Meet + Gmail send =====
# One OAuth grant covers both interview scheduling (real Meet links) and
# sending real email via the Gmail API. If left blank, scheduling returns
# a clear setup error instead of ever creating a fake meeting link, and
# email falls through to SendGrid/SMTP above. See README for how to obtain
# GOOGLE_REFRESH_TOKEN via `npm run google:auth` (server/utils/googleAuthSetup.js).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
